# IntelliSight Dashboard Configuration
# Copy this file to .env and configure your settings

# Backend API URL (Node.js)
VITE_API_BASE_URL=http://localhost:3000/api

# Python camera streaming service URL (Flask — camera_streaming_service.py)
VITE_STREAM_BASE_URL=http://localhost:5001

# Real-time update interval (milliseconds)
VITE_POLLING_INTERVAL=5000

# Admin credentials (for testing)
VITE_ADMIN_EMAIL=john.admin@intellisight.com
VITE_ADMIN_PASSWORD=admin123
