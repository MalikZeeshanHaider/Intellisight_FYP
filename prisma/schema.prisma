generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  Admin_ID Int     @id @default(autoincrement())
  Name     String?
  Email    String? @unique
  Password String?
  Role     String?
  Logs     Logs[]

  @@map("Admin")
}

model PendingUsers {
  Pending_ID       Int      @id @default(autoincrement())
  Name             String
  Email            String   @unique
  Password         String
  VerificationToken String  @unique
  Status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  RequestedAt      DateTime @default(now())
  ProcessedAt      DateTime?
  ProcessedBy      Int?
  RejectionReason  String?

  @@map("PendingUsers")
}

model PasswordResets {
  Reset_ID   Int      @id @default(autoincrement())
  Email      String
  Token      String   @unique
  ExpiresAt  DateTime
  CreatedAt  DateTime @default(now())
  Used       Boolean  @default(false)

  @@map("PasswordResets")
}

model Zone {
  Zone_id        Int              @id @default(autoincrement())
  Zone_Name      String?
  Description    String?
  ActivePresence ActivePresence[]
  AttendanceLog  AttendanceLog[]
  Camara         Camara[]
  Logs           Logs[]
  TimetableSlots TimetableSlot[]

  @@map("Zone")
}

model Camara {
  Camara_Id   Int     @id @default(autoincrement())
  Password    String?
  Zone_id     Int?
  Camera_Type String? @default("Entry")
  Camera_URL  String?
  zone        Zone?   @relation(fields: [Zone_id], references: [Zone_id])

  @@map("Camara")
}

model Teacher {
  Teacher_ID      Int                   @id @default(autoincrement())
  Name            String?
  Email           String?               @unique
  CreatedAt       DateTime              @default(now())
  Department      String?
  Profile_Picture String?
  Face_Picture_1  String?
  Face_Picture_2  String?
  Face_Picture_3  String?
  Face_Picture_4  String?
  Face_Picture_5  String?
  Face_Embeddings Bytes?
  Faculty_Type    String?
  Gender          String?
  UpdatedAt       DateTime              @updatedAt
  ActivePresence  ActivePresence[]
  AttendanceLog   AttendanceLog[]
  FaceEmbeddings  FaceEmbeddings[]
  Logs            Logs[]
  ProcessedImages ProcessedFaceImages[]
  TimetableSlots  TimetableSlot[]
  ClassAttendance ClassAttendance[]

  @@map("Teacher")
}

model Students {
  Student_ID      Int                   @id @default(autoincrement())
  Name            String?
  RollNumber      String?               @unique
  Email           String?               @unique
  Profile_Picture String?
  Face_Picture_1  String?
  Face_Picture_2  String?
  Face_Picture_3  String?
  Face_Picture_4  String?
  Face_Picture_5  String?
  Face_Embeddings Bytes?
  CreatedAt       DateTime              @default(now())
  UpdatedAt       DateTime              @updatedAt
  Department      String?
  Gender          String?
  Section_ID      Int?
  section         Section?              @relation("StudentSection", fields: [Section_ID], references: [Section_ID])
  ActivePresence  ActivePresence[]
  AttendanceLog   AttendanceLog[]
  FaceEmbeddings  FaceEmbeddings[]
  Logs            Logs[]
  ProcessedImages ProcessedFaceImages[]
  Enrollments     Enrollment[]
  ClassAttendance ClassAttendance[]

  @@map("Students")
}

model UnknownFaces {
  Unknown_ID     Int      @id @default(autoincrement())
  Captured_Image Bytes?
  DetectedTime   DateTime @default(now())
  Zone_id        Int?
  Confidence     Float?
  Status         String?  @default("PENDING")
  Notes          String?
  CreatedAt      DateTime @default(now())

  @@map("UnknownFaces")
}

model ActivePresence {
  Presence_ID Int       @id @default(autoincrement())
  PersonType  String
  Student_ID  Int?
  Teacher_ID  Int?
  Zone_id     Int
  EntryTime   DateTime  @default(now())
  student     Students? @relation(fields: [Student_ID], references: [Student_ID], onDelete: Cascade)
  teacher     Teacher?  @relation(fields: [Teacher_ID], references: [Teacher_ID], onDelete: Cascade)
  zone        Zone      @relation(fields: [Zone_id], references: [Zone_id], onDelete: Cascade)

  @@map("ActivePresence")
}

model AttendanceLog {
  Log_ID     Int       @id @default(autoincrement())
  PersonType String
  Student_ID Int?
  Teacher_ID Int?
  Zone_id    Int
  EntryTime  DateTime
  ExitTime   DateTime?
  Duration   Int?
  CreatedAt  DateTime  @default(now())
  student    Students? @relation(fields: [Student_ID], references: [Student_ID], onDelete: Cascade)
  teacher    Teacher?  @relation(fields: [Teacher_ID], references: [Teacher_ID], onDelete: Cascade)
  zone       Zone      @relation(fields: [Zone_id], references: [Zone_id], onDelete: Cascade)

  @@map("AttendanceLog")
}

model ProcessedFaceImages {
  Processed_ID Int       @id @default(autoincrement())
  PersonType   String
  Student_ID   Int?
  Teacher_ID   Int?
  Image1       Bytes?
  Image2       Bytes?
  Image3       Bytes?
  Image4       Bytes?
  Image5       Bytes?
  CreatedAt    DateTime  @default(now())
  student      Students? @relation(fields: [Student_ID], references: [Student_ID], onDelete: Cascade)
  teacher      Teacher?  @relation(fields: [Teacher_ID], references: [Teacher_ID], onDelete: Cascade)

  @@map("ProcessedFaceImages")
}

model FaceEmbeddings {
  Embedding_ID     Int       @id @default(autoincrement())
  PersonType       String
  Student_ID       Int?
  Teacher_ID       Int?
  PersonName       String?
  ImagePath        String?
  Embedding        Bytes
  EmbeddingJson    String?
  // Enrollment quality metadata — populated by enrollment.py v2 pipeline.
  // Run migration: ALTER TABLE "FaceEmbeddings"
  //   ADD COLUMN "QualityScore" FLOAT,
  //   ADD COLUMN "IsCentroid" BOOLEAN NOT NULL DEFAULT FALSE,
  //   ADD COLUMN "SourceImageIndex" INT;
  QualityScore     Float?    // 0.0–1.0 composite score (sharpness + brightness + contrast + detection)
  IsCentroid       Boolean   @default(false) // true = averaged centroid of all accepted embeddings
  SourceImageIndex Int?      // which Face_Picture_N this came from (1–5); NULL for centroid rows
  CreatedAt        DateTime  @default(now())
  UpdatedAt        DateTime  @updatedAt
  student          Students? @relation(fields: [Student_ID], references: [Student_ID], onDelete: Cascade)
  teacher          Teacher?  @relation(fields: [Teacher_ID], references: [Teacher_ID], onDelete: Cascade)

  @@map("FaceEmbeddings")
}

model Logs {
  Logs_ID    Int       @id @default(autoincrement())
  EntryTime  DateTime?
  ExitTime   DateTime?
  PersonType String?
  Admin_ID   Int?
  Teacher_ID Int?
  Student_ID Int?
  Zone_id    Int?
  Admin      Admin?    @relation(fields: [Admin_ID], references: [Admin_ID])
  Students   Students? @relation(fields: [Student_ID], references: [Student_ID])
  Teacher    Teacher?  @relation(fields: [Teacher_ID], references: [Teacher_ID])
  Zone       Zone?     @relation(fields: [Zone_id], references: [Zone_id])
}

// ─── Course (e.g., "Object Oriented Programming") ───
model Course {
  Course_ID      Int              @id @default(autoincrement())
  Name           String                      // "Object Oriented Programming"
  Code           String           @unique    // "CS-301"
  CreditHours    Int?                        // 3
  Department     String?                     // "Computer Science"
  CreatedAt      DateTime         @default(now())
  UpdatedAt      DateTime         @updatedAt

  TimetableSlots TimetableSlot[]

  @@map("Course")
}

// ─── Section (e.g., "BSIT-VIII-A (Shift-I)") ───
model Section {
  Section_ID     Int              @id @default(autoincrement())
  Name           String           @unique    // "BSIT-VIII-A (Shift-I)"
  Department     String?                     // "Computer Science"
  Semester       String?                     // "8th"
  Shift          String?                     // "Morning" / "Evening"
  CreatedAt      DateTime         @default(now())
  UpdatedAt      DateTime         @updatedAt

  Enrollments    Enrollment[]
  Students       Students[]        @relation("StudentSection")
  TimetableSlots TimetableSlot[]

  @@map("Section")
}

// ─── Enrollment (which students belong to which section) ───
model Enrollment {
  Enrollment_ID Int      @id @default(autoincrement())
  Section_ID    Int
  Student_ID    Int
  CreatedAt     DateTime @default(now())

  section       Section  @relation(fields: [Section_ID], references: [Section_ID], onDelete: Cascade)
  student       Students @relation(fields: [Student_ID], references: [Student_ID], onDelete: Cascade)

  @@unique([Section_ID, Student_ID]) // one student enrolled once per section
  @@map("Enrollment")
}

// ─── TimetableSlot (one row = one class block in the week) ───
model TimetableSlot {
  Slot_ID         Int               @id @default(autoincrement())
  Section_ID      Int
  Course_ID       Int?                       // FK to Course (nullable for manual entry)
  Teacher_ID      Int?                       // FK to existing Teacher (nullable if just a name)
  TeacherName     String?                    // fallback: plain text name
  SubjectName     String                     // "Object Oriented Programming"
  DayOfWeek       String                     // "MON","TUE","WED","THU","FRI"
  StartTime       String                     // "09:00"
  EndTime         String                     // "10:00"
  Zone_id         Int?                       // FK to existing Zone (room/lab)
  RoomName        String?                    // fallback: plain text "Room-301"
  IsActive        Boolean           @default(true)
  CreatedAt       DateTime          @default(now())
  UpdatedAt       DateTime          @updatedAt

  section         Section           @relation(fields: [Section_ID], references: [Section_ID], onDelete: Cascade)
  course          Course?           @relation(fields: [Course_ID], references: [Course_ID], onDelete: SetNull)
  teacher         Teacher?          @relation(fields: [Teacher_ID], references: [Teacher_ID], onDelete: SetNull)
  zone            Zone?             @relation(fields: [Zone_id], references: [Zone_id], onDelete: SetNull)
  ClassAttendance ClassAttendance[]

  @@unique([Section_ID, DayOfWeek, StartTime]) // no duplicate slot for same section/day/time
  @@map("TimetableSlot")
}

// ─── ClassAttendance (computed from camera logs per slot per day) ───
model ClassAttendance {
  Attendance_ID   Int            @id @default(autoincrement())
  Slot_ID         Int                        // which timetable slot
  Date            DateTime       @db.Date    // which day (2026-03-01)
  PersonType      String                     // "STUDENT" or "TEACHER"
  Student_ID      Int?
  Teacher_ID      Int?
  Status          String         @default("ABSENT") // "PRESENT","ABSENT","LATE"
  FirstSeenAt     DateTime?                  // first camera detection in that slot window
  LastSeenAt      DateTime?                  // last camera detection
  TotalMinutes    Int?                       // total time detected in slot
  DetectionsCount Int            @default(0) // how many times camera saw them
  CreatedAt       DateTime       @default(now())
  UpdatedAt       DateTime       @updatedAt

  slot            TimetableSlot  @relation(fields: [Slot_ID], references: [Slot_ID], onDelete: Cascade)
  student         Students?      @relation(fields: [Student_ID], references: [Student_ID], onDelete: Cascade)
  teacher         Teacher?       @relation(fields: [Teacher_ID], references: [Teacher_ID], onDelete: Cascade)

  @@unique([Slot_ID, Date, Student_ID]) // one record per student per slot per day
  @@unique([Slot_ID, Date, Teacher_ID]) // one record per teacher per slot per day
  @@map("ClassAttendance")
}
