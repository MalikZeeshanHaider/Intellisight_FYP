# ============================================================
# IntelliSight - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER put real secrets in this file — it is committed to Git.
# ============================================================

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?schema=public"
DB_HOST=localhost
DB_PORT=5000
DB_NAME=FYP_Intellisight
DB_USER=postgres
DB_PASSWORD=ozair

# ── JWT ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=5d3277da07f140cca52b3221f316586bc44774063c035de64022d8b6fe34ec726a1b744dc6bab5ac03e89b74ac6088f
f50264dbb4550925f250b5154291536e6
JWT_EXPIRES_IN=7d

# ── Bcrypt ────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# ── Email (Gmail App Password) ────────────────────────────
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=221083@students.au.edu.pk
EMAIL_PASS=nfhvmhsrqrurmqvv
ADMIN_EMAIL=221083@students.au.edu.pk

# ── Super Admin Account ───────────────────────────────────
SUPER_ADMIN_EMAIL=intellisight@gmail.com
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_NAME=Super Administrator

# ── Seed Admin Password (used by prisma/seed.js only) ─────
SEED_ADMIN_PASSWORD=YOUR_SEED_ADMIN_PASSWORD_HERE

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ── CORS (comma-separated allowed origins) ────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── File Upload ───────────────────────────────────────────
MAX_FILE_SIZE=5242880

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info

# ── MediaMTX (video media server) ────────────────────────
# MediaMTX handles RTSP → WebRTC/HLS. Run it alongside the Python AI service.
# See Facerecongination/mediamtx/README.md for install & config.
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_WEBRTC_URL=http://localhost:8889
